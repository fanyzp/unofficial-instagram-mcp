# Browser yang dipakai server: Chrome yang SUDAH jalan + SUDAH login Instagram.
# Jalankan: google-chrome --remote-debugging-port=9222
CDP_URL=http://127.0.0.1:9222
# Cadangan: USER_DATA_DIR=./data/chrome-profile  (login manual sekali)

# Keamanan aksi tulis:
# true  = aksi kirim DM / like / post hanya DISIMULASIKAN (disiapkan, tidak dieksekusi final)
# false = aksi benar-benar dilakukan saat tool dipanggil
IG_DRY_RUN=true

# Jeda manusiawi antar aksi (ms)
MIN_DELAY_MS=2500
MAX_DELAY_MS=7000

# Self-test resmi:
# IG_SELFTEST_ON_CONNECT=true  -> level safe (baca saja) jalan sekali saat koneksi MCP pertama
# Level full (menguji SEMUA fungsi tulis, lalu menghapus konten tesnya sendiri) butuh:
# IG_SELFTEST_FULL=true, IG_DRY_RUN=false, dan IG_SELFTEST_ACCOUNT=<username akun kedua>
# PERINGATAN: level full HANYA di akun kedua (second account), jangan akun utama.
IG_SELFTEST_ON_CONNECT=false
IG_SELFTEST_FULL=false
IG_SELFTEST_ACCOUNT=
IG_SELFTEST_TARGET=instagram
# IG_SELFTEST_DM_TARGET=   (opsional: username akun milik sendiri untuk tes dm_send_to_user)
